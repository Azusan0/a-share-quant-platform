[Unit]
Description=A Share Multi-account Portfolio Monitor
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/hermes-agent/a_share_alert_template
ExecStartPre=/usr/local/lib/hermes-agent/venv/bin/python /usr/local/lib/hermes-agent/a_share_alert_template/global_market_factor.py --max-age-minutes 6
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python /usr/local/lib/hermes-agent/a_share_alert_template/portfolio_monitor.py
StateDirectory=a-share-dashboard
TimeoutStartSec=90
Nice=5
