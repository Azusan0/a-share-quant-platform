[Unit]
Description=A Share US Japan Korea Market Factor Collector
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/hermes-agent/a_share_alert_template
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python /usr/local/lib/hermes-agent/a_share_alert_template/global_market_factor.py --max-age-minutes 4
TimeoutStartSec=90
Nice=10

