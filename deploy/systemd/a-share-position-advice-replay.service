[Unit]
Description=A Share Dynamic Exit Advice Replay
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/hermes-agent/a_share_alert_template
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python /usr/local/lib/hermes-agent/a_share_alert_template/position_advice_replay.py
StateDirectory=a-share-dashboard
TimeoutStartSec=120
Nice=10
