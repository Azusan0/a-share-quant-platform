# A-Share Dashboard 环境变量示例
# 复制到 /etc/a-share-dashboard.env 并按需修改。
# 该文件不要提交到版本库。

# ── HTTP Basic 认证 ────────────────────────────────────────────
DASHBOARD_USER=viewer
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── CSRF 令牌签名密钥（留空则每次启动随机生成，重启后旧令牌失效）
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
DASHBOARD_CSRF_SECRET=
DASHBOARD_CSRF_TTL_SECONDS=3600

# ── 可信 Host 边界（逗号分隔；留空则不校验，生产环境务必配置）
# 支持主机名或 IP；用于阻断 Host 头攻击与跨站写入
DASHBOARD_TRUSTED_HOSTS=dash.example.com

# ── 登录失败限流 ───────────────────────────────────────────────
DASHBOARD_AUTH_WINDOW_SECONDS=300
DASHBOARD_AUTH_MAX_FAILURES=8

# ── 安全审计日志 ───────────────────────────────────────────────
DASHBOARD_SECURITY_AUDIT=/var/lib/a-share-dashboard/security_audit.jsonl

# ── 数据源路径 ─────────────────────────────────────────────────
PORTFOLIO_DB=/var/lib/a-share-dashboard/portfolios.db
DASHBOARD_QUOTE_TTL_SECONDS=8

# ── 运行时数据目录（与 runtime_config 中的路径保持一致）──────────
A_SHARE_RUNTIME_DIR=/root/.hermes/scripts
A_SHARE_TRADE_DATES_FILE=
