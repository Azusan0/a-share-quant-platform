[Unit]
Description=A Share Intraday Offline Replay Audit
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/hermes-agent/a_share_alert_template
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python /usr/local/lib/hermes-agent/a_share_alert_template/intraday_replay.py --date latest --output /root/.hermes/scripts/a_share_intraday_replay.json
TimeoutStartSec=180
Nice=10
